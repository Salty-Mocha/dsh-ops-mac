{
  "name": "dsh-ops",
  "version": "0.3.0-mac.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-Auto/dsh-ops.git"
  },
  "homepage": "https://github.com/T-Auto/dsh-ops#readme",
  "bugs": {
    "url": "https://github.com/T-Auto/dsh-ops/issues"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "description": "macOS arm64 port of dsh-ops: native Rust file tools + PTC batch/result. Shell component (bundled bash/pwsh) removed; uses host shell.",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "fastctx",
    "repository-tools"
  ],
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./policy": {
      "default": "./lib/policy.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./file": {
      "default": "./lib/components/file/index.js"
    },
    "./file/package.json": "./lib/components/file/package.json",
    "./file/locale/*.json": "./lib/components/file/locale/*.json",
    "./ptc": {
      "default": "./lib/components/ptc/index.js"
    },
    "./ptc/package.json": "./lib/components/ptc/package.json",
    "./ptc/locale/*.json": "./lib/components/ptc/locale/*.json"
  },
  "bin": {
    "dsh-ops": "bin/dsh-ops.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "icon.png",
    "locale",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "PROVENANCE.md",
    "CHANGELOG.md",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/src",
    "runtime"
  ],
  "scripts": {
    "status": "node bin/dsh-ops.mjs status",
    "build:ptc": "node bin/dsh-ops.mjs build-ptc",
    "build:rust": "node bin/dsh-ops.mjs build",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "test": "node test/run.mjs",
    "verify:release": "npm run verify && node bin/check-release.mjs",
    "verify": "node scripts/validate-manifest.mjs && node test/run.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dsh-std/manifest": "^0.1.1-rc.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
